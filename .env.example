# Environment Configuration
# Copy this file to .env.local and update with your settings

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True

# Database
DATABASE_URL=sqlite:///fake_news.db

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Model Configuration
CACHE_ENABLED=True
CACHE_TTL=3600

# Feature Flags
ENABLE_EXPLAINABILITY=True
ENABLE_MODEL_COMPARISON=True
ENABLE_ENSEMBLE=True
